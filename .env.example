# Gemini server-side key. Add it in Google AI Studio Settings > Secrets when deployed.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Public browser key for Google Maps JavaScript API (not a secret).
# Restrict it in Google Cloud by allowed website referrers and enabled APIs.
VITE_GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_BROWSER_KEY

# Optional hosting port; platforms may provide this automatically.
PORT=3000
